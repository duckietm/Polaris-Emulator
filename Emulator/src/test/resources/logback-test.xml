<?xml version="1.0" encoding="UTF-8"?>
<!-- Test logging: synchronous console output (the production async appenders may
     drop lines under load), short stack traces for the exceptions tests provoke on
     purpose, and quiet third-party loggers. A test failure is reported by JUnit
     with its own trace, so the log only needs enough to locate an unexpected error. -->
<configuration>
    <conversionRule conversionWord="morningstarLevel" class="com.eu.habbo.util.logback.ConsoleLevelConverter" />
    <conversionRule conversionWord="morningstarLogger" class="com.eu.habbo.util.logback.ConsoleLoggerConverter" />

    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %morningstarLevel [%-12thread] %morningstarLogger | %msg%n%ex{4}</pattern>
        </encoder>
    </appender>

    <!-- One line per applied migration is noise across dozens of fresh schemas. -->
    <logger name="org.flywaydb" level="WARN"/>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="tc" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="ERROR"/>
    <logger name="org.mariadb.jdbc" level="WARN"/>
    <logger name="org.hibernate.validator" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="Console" />
    </root>
</configuration>
